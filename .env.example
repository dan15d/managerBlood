# Copia este archivo como .env.local y rellena lo que quieras usar. Todo es opcional:
# sin Supabase las partidas se guardan en el navegador; sin IA solo funciona el modo manual.

# Supabase (https://supabase.com → Project Settings → API). La clave "anon" es pública por diseño:
# lo que protege los datos son las políticas RLS de supabase/migrations.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Modelo de OpenRouter para el modo IA (la clave NO va aquí: va como secreto de la Edge Function
# o, para pruebas, en Ajustes dentro de la app, que la guarda solo en tu navegador).
VITE_AI_MODEL=deepseek/deepseek-v4.1-flash
